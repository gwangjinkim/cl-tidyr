(in-package #:cl-tidyr)

(define-condition tidyr-error (tidy-error)
  ((message :initarg :message :reader tidyr-error-message))
  (:report (lambda (condition stream) (write-string (tidyr-error-message condition) stream))))
(define-condition tidyr-warning (tidy-warning)
  ((message :initarg :message :reader tidyr-warning-message))
  (:report (lambda (condition stream) (write-string (tidyr-warning-message condition) stream))))
(defun %tr-error (control &rest arguments)
  (error 'tidyr-error :message (apply #'format nil control arguments)))
(defun %tr-name (name)
  (cond ((stringp name) name)
        ((and (symbolp name) name) (string-downcase (symbol-name name)))
        (t (%tr-error "Invalid column name: ~S." name))))
(defun %tr-mode (value)
  (if (stringp value) (intern (string-upcase (substitute #\- #\_ value)) :keyword) value))
(defun %tr-float-nan-p (value)
  (and (floatp value)
       #+sbcl (sb-ext:float-nan-p value)
       #-sbcl (handler-case (not (= value value))
                (floating-point-invalid-operation () t))))
(defun %tr-na-p (value)
  (or (na-p value) (%tr-float-nan-p value)))
(defun %tr-column (x)
  "Normalize legacy columns locally; explicit C2 logical FALSE stays NIL."
  (when (or (typep x 'cl-tibble:tbl) (and (arrayp x) (> (array-rank x) 1)))
    (%tr-error "Nested tibble and matrix columns need an owner-preserving C2 protocol."))
  (cond
    ((listp x) (make-typed-column (coerce x 'vector) :list))
    ((not (column-p x)) (make-typed-column (vector x) (value-type x)))
    ;; Old tidyr fixtures used NIL in otherwise numeric/string raw vectors.
    ;; Typed columns and owner objects have an unambiguous C1 representation.
    ((and (vectorp x) (not (gethash x cl-vctrs-lite::*column-prototypes*))
          (position nil x))
     (let* ((present (remove-if (lambda (v) (or (null v) (%tr-na-p v))) (coerce x 'list)))
            (tag (and present (reduce #'common-type present :key #'value-type))))
       ;; NaN remains a double-type witness even though its cell is missing.
       (when (some #'%tr-float-nan-p x) (setf tag (common-type (or tag :na) :double)))
       (if (member tag '(:int :double :string))
           (make-typed-column (map 'vector (lambda (v) (if (or (null v) (%tr-na-p v)) *na* v)) x) tag)
           x)))
    (t x)))
(defun %tr-argument-column (x)
  "Normalize public scalar inputs separately from legacy data-column storage."
  (cond ((null x) (make-typed-column #(nil) :bool))
        ((na-p x) (make-typed-column (vector *na*) :bool))
        ((or (functionp x) (and (not (column-p x)) (eq :any (value-type x))))
         (%tr-error "Expected a vector or supported scalar, not ~S." x))
        (t (%tr-column x))))
(defun %tr-data-column (data name) (%tr-column (cl-tibble:tbl-col data name)))
(defun %tr-missing (value column)
  (if (eq (col-type column) :list) (null value) (%tr-na-p value)))
(defun %tr-frame (names columns nrows &optional (repair :check-unique))
  ;; The tibble allocator is required for positive-row zero-column frames and
  ;; positional minimally named columns. All input sizes were checked by caller.
  (cl-tibble::%allocate-tbl (cl-tibble::%tb-repair-names (coerce names 'vector) repair)
                          (coerce columns 'vector) nrows))
(defun %tr-copy-names (result original)
  (let ((names (col-names original))) (when names (setf (col-names result) names))) result)
(defun %tr-restore (values original &optional (preserve-names t))
  (let ((result (restore-column (coerce values 'vector) (vec-prototype original))))
    (when preserve-names (%tr-copy-names result original)) result))
(defun %tr-subset (data rows &optional (names nil names-p))
  (let ((names (if names-p names (coerce (cl-tibble:tbl-names data) 'list))))
    (%tr-frame names (mapcar (lambda (name) (col-subseq (%tr-data-column data name) rows)) names)
               (length rows))))
(defun %tr-selected-names (data specs &optional all-if-empty)
  (if (and (null specs) all-if-empty) (coerce (cl-tibble:tbl-names data) 'list)
      (coerce (cl-tibble:tbl-names (select-cols data specs)) 'list)))
(defun %tr-pairs (spec)
  (cond ((null spec) nil)
        ((named-list-p spec) (mapcar (lambda (p) (cons (car p) (cdr p))) spec))
        ((and (listp spec) (evenp (length spec)))
         (loop for (name value) on spec by #'cddr collect (cons (%tr-name name) value)))
        (t (%tr-error "Expected a named replacement list or flat property list."))))
(defun %tr-replacement (replacement column)
  (let ((value (if (eq (col-type column) :list)
                   (cond ((and (column-p replacement) (= 1 (col-length replacement)))
                          (col-ref replacement 0))
                         (t (%tr-error "A list replacement must have size one.")))
                   (let ((input (if (or (null replacement) (not (column-p replacement))) (vector replacement) (%tr-column replacement))))
                     (unless (= 1 (col-length input)) (%tr-error "Replacement must have size one."))
                     (col-ref (vec-cast input (vec-prototype column)) 0))))) value))

;;; Optional grouping uses dynamic discovery so tidyr remains loadable without
;;; cl-dplyr and does not require its private grouped wrapper at compile time.
(defun %tr-dplyr-symbol (name)
  (let ((package (find-package :cl-dplyr))) (and package (find-symbol name package))))
(defun %tr-grouped-p (data)
  (let ((symbol (%tr-dplyr-symbol "GROUPED-TIBBLE")))
    (and symbol (find-class symbol nil) (typep data symbol))))
(defun %tr-group-data (data) (funcall (%tr-dplyr-symbol "GROUP-DATA") data))
(defun %tr-group-keys (data) (mapcar #'%tr-name (coerce (funcall (%tr-dplyr-symbol "GROUP-KEYS") data) 'list)))
(defun %tr-cell-equal (a b)
  (cond ((and (stringp a) (stringp b)) (string= a b))
        ((and (numberp a) (numberp b)) (= a b))
        ((and (consp a) (consp b)) (and (%tr-cell-equal (car a) (car b)) (%tr-cell-equal (cdr a) (cdr b))))
        ((and (vectorp a) (vectorp b) (not (stringp a)) (not (stringp b)))
         (and (= (length a) (length b)) (eq (col-type a) (col-type b))
              (equal (prototype-levels (vec-prototype a)) (prototype-levels (vec-prototype b)))
              (eq (prototype-ordered (vec-prototype a)) (prototype-ordered (vec-prototype b)))
              (%tr-cell-equal (col-names a) (col-names b)) (every #'%tr-cell-equal a b)))
        ((and (typep a 'local-time:timestamp) (typep b 'local-time:timestamp)) (local-time:timestamp= a b))
        (t (eql a b))))
(defun %tr-row-equal (a b) (%tr-cell-equal a b))
(defun %tr-value< (a b &optional column)
  (cond ((na-p a) nil) ((na-p b) t)
        ((%tr-cell-equal a b) nil)
        ((and column (eq (col-type column) :factor))
         (< (position a (prototype-levels (vec-prototype column)) :test #'equal)
            (position b (prototype-levels (vec-prototype column)) :test #'equal)))
        ((and column (eq (col-type column) :list))
         (cond ((null a) nil) ((null b) t)
               (t (< (position a (col->list column) :test #'%tr-cell-equal)
                     (position b (col->list column) :test #'%tr-cell-equal)))))
        ((and (realp a) (realp b)) (< a b))
        ((and (stringp a) (stringp b)) (%tr-string< a b))
        ((and (member a '(nil t)) (member b '(nil t))) (null a))
        ((and column (member (col-type column) '(:date :datetime)))
         (uiop:symbol-call :local-time :timestamp< a b))
        ;; R's vector order for list cells is their first-appearance order.
        (t nil)))
(defun %tr-row< (a b columns &optional c-order)
  (loop for x in a for y in b for column in columns
        for character-key = (and c-order (eq (col-type column) :string)
                                 (stringp x) (stringp y))
        do (cond ((if character-key (string< x y) (%tr-value< x y column)) (return t))
                 ((if character-key (string< y x) (%tr-value< y x column)) (return nil)))
        finally (return nil)))
(defun %tr-groups (data keys)
  (let* ((columns (mapcar (lambda (name) (%tr-data-column data name)) keys))
         (groups nil))
    (dotimes (i (cl-tibble:tbl-nrows data))
      (let* ((key (mapcar (lambda (col) (col-ref col i)) columns))
             (entry (assoc key groups :test #'%tr-row-equal)))
        (if entry (push i (cdr entry)) (push (cons key (list i)) groups))))
    (dolist (entry groups) (setf (cdr entry) (nreverse (cdr entry))))
    (stable-sort groups (lambda (a b) (%tr-row< (car a) (car b) columns t)))))
(defun %tr-regroup (data keys)
  (let ((keys (remove-if-not (lambda (key) (find key (cl-tibble:tbl-names data) :test #'equal)) keys)))
    (if keys (funcall (%tr-dplyr-symbol "MAKE-GROUPED-TIBBLE") :data data :keys keys :groups (%tr-groups data keys))
        data)))
(defun %tr-bind-frames (frames empty)
  (if (null frames) empty
      (let* ((names (coerce (cl-tibble:tbl-names (first frames)) 'list))
             (n (reduce #'+ frames :key #'cl-tibble:tbl-nrows)))
        (%tr-frame names
                   (mapcar (lambda (name)
                             (let ((original (%tr-data-column (first frames) name)))
                               (%tr-restore (loop for frame in frames append
                                                  (col->list (%tr-data-column frame name))) original nil))) names)
                   n))))
